# Compose reads this file. The Python app reads process environment only.
# Copy to .env locally. Never put real secrets in this example.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_PORT=5173
APP_TIMEZONE=Asia/Seoul
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required before starting the API. Generate a random secret locally.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
# Local demo only. Disable for any publicly accessible deployment.
DEMO_ACCOUNT_SWITCH_ENABLED=true

# Local development placeholders only. Keep password and DATABASE_URL in sync.
POSTGRES_DB=shiftlink
POSTGRES_USER=shiftlink
POSTGRES_PASSWORD=replace_for_local_development
# Compose host is db; use localhost when running the API outside Compose.
DATABASE_URL=postgresql+psycopg://shiftlink:replace_for_local_development@db:5432/shiftlink

# Backend/worker only. Fill with an actual accessible model after a smoke test.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
# live: actual API; fake: automated tests only; replay: recorded real execution.
WORKER_MODE=maintenance
# Switch WORKER_MODE to live only with a valid key/model; maintenance never claims jobs.
AGENT_MODE=live
AGENT_RUN_DEADLINE_SECONDS=60
AGENT_MAX_MODEL_CALLS=7
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_OUTPUT_TOKENS=2000
AGENT_MAX_INPUT_BYTES=262144
SEARCH_MAX_CHUNKS=5
SEARCH_MAX_CHUNK_CHARS=2000
WORKER_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=90
JOB_MAX_ATTEMPTS=3

# Public browser settings only; VITE_* must never contain credentials.
VITE_API_BASE_URL=/api/v1
VITE_POLL_INTERVAL_MS=2000
